<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Songify.Core\Songify.Core.csproj" />
    <ProjectReference Include="..\Songify.Spotify\Songify.Spotify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 (Windows 10 2004): needed by the Spotify recorder's per-app audio capture -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The download is Songify.exe; release builds set Version from the git tag (v1.2.3 → 1.2.3). -->
    <AssemblyName>Songify</AssemblyName>
    <Product>Songify</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
